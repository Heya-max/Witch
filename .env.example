BOT_TOKEN=
API_ID=
API_HASH=
# Host URLs for running the bot directly. Inside docker compose these are
# overridden with the service names (postgres:5432 / redis:6379). Host
# Postgres is published on 5433 to avoid clashing with a native install.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/telegram_music
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
BOT_OWNER_ID=
