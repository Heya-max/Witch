BOT_TOKEN=
API_ID=
API_HASH=
# Optional userbot assistant so the bot can create/join voice chats itself
# (bots cannot create group calls). Enable EITHER a session file name:
#   USERBOT_SESSION=user
# or an in-memory session string:
#   USERBOT_SESSION_STRING=
# plus optional account-specific credentials (fall back to API_ID/API_HASH):
#   USERBOT_API_ID=
#   USERBOT_API_HASH=
# Generate a session with: python scripts/create_user_session.py
# Host URLs for running the bot directly. Inside docker compose these are
# overridden with the service names (postgres:5432 / redis:6379). Host
# Postgres is published on 5433 to avoid clashing with a native install.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/telegram_music
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
BOT_OWNER_ID=
# Observability. Structured JSON logs are always on; METRICS_PORT exposes the
# Prometheus endpoint locally (default 9090, inside Docker it binds 0.0.0.0).
# Set to 0 to disable the metrics server entirely.
METRICS_PORT=9090
# Queue health knobs (see README):
QUEUE_MAX_SIZE=200
QUEUE_MAX_AGE_SECONDS=86400
PLAY_MAX_RETRIES=2
# LYRICS_API_BASE=https://api.lyrics.ovh/v1
